# Staging — keep the ERA prototype out of every index.
/*
  X-Robots-Tag: noindex, nofollow

# Photography and video never change once published.
/media/*
  Cache-Control: public, max-age=604800

# The shared stylesheet is not content-hashed, so keep the window short and
# let the CDN serve stale while it revalidates.
/v2/era.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
